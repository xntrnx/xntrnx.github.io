# Copia este archivo a ".env" y llena los valores. Nunca subas ".env" al repositorio.
# (En desarrollo: `node --env-file=.env src/server.js`; en producción usa las
# variables de entorno / "secrets" de tu proveedor de hosting.)

NODE_ENV=production
PORT=3000

# URL pública del sitio, con https y sin diagonal final. Se usa en correos y en PayPal.
BASE_URL=https://tu-dominio.com

# Carpeta persistente: base de datos, fotos subidas, respaldos. Debe vivir en un
# volumen/disco persistente del hosting.
DATA_DIR=./data

# Número de proxies de confianza delante de la app (1 en Fly.io, Railway, Render, nginx).
TRUST_PROXY=1

# ---------- Identidad del sitio ----------
SITE_NAME=una pausa, Cecahuitl
ARTIST_NAME=Cecahuitl
CONTACT_EMAIL=hola@tu-dominio.com
# Opcional. Formato: 521XXXXXXXXXX (sin +, sin espacios)
CONTACT_WHATSAPP=

# ---------- Responsable de los datos personales (OBLIGATORIO antes de lanzar) ----------
# Nombre legal completo de la persona física o moral responsable (tal como aparece en tu RFC).
LEGAL_NAME=
# Domicilio completo para oír y recibir notificaciones (calle, número, colonia, CP, ciudad, estado, país).
LEGAL_ADDRESS=
# Correo al que se envían las solicitudes de privacidad (ARCO / GDPR).
PRIVACY_EMAIL=privacidad@tu-dominio.com
# Opcional: representante en la UE / Reino Unido (art. 27 RGPD) si llegas a necesitarlo.
EU_REPRESENTATIVE=
UK_REPRESENTATIVE=
# Dónde están físicamente los servidores (p. ej. "Estados Unidos (Fly.io, región Dallas)").
HOSTING_LOCATION=
# Proveedor de correo transaccional (p. ej. "Postmark (EE. UU.)").
EMAIL_PROVIDER=

# ---------- Correo saliente ----------
# URL SMTP de tu proveedor. Si se deja vacío, los correos se guardan en DATA_DIR/outbox
# (útil en desarrollo; en producción ES NECESARIO configurarlo).
SMTP_URL=smtps://usuario:contraseña@smtp.tu-proveedor.com:465
MAIL_FROM="una pausa, Cecahuitl <hola@tu-dominio.com>"
# A dónde llegan los avisos internos (pedidos nuevos, SPEI por confirmar, solicitudes de privacidad).
ADMIN_NOTIFY_EMAIL=hola@tu-dominio.com

# ---------- PayPal (developer.paypal.com → Apps & Credentials) ----------
# "sandbox" mientras pruebas, "live" para cobrar de verdad.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# ---------- Transferencia SPEI ----------
SPEI_CLABE=
SPEI_BANCO=
SPEI_BENEFICIARIO=

# ---------- Envíos (en pesos MXN; 0 = incluido en el precio) ----------
SHIPPING_MX_MXN=0
SHIPPING_INTL_MXN=0

# ---------- Reglas de negocio ----------
# Horas que una obra queda apartada esperando el pago de una compra directa.
ORDER_HOLD_HOURS=24
# Horas que tiene quien gana una subasta para pagar.
AUCTION_PAY_HOURS=72
